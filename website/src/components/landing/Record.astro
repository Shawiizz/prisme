---
/** A timecode record turning at 33⅓, its grooves catching a still light. */
import mark from '../../assets/logo-mark.svg?url';

const grooves = Array.from({ length: 34 }, (_, i) => 68 + i * 3.2);
---

<div class="record" aria-hidden="true">
	<svg class="disc" viewBox="0 0 400 400">
		<circle cx="200" cy="200" r="196" fill="#08090b" />
		{grooves.map((r, i) => <circle cx="200" cy="200" r={r} class={i % 9 === 0 ? 'gap' : 'groove'} />)}
		<circle cx="200" cy="200" r="182" class="timecode" />
		<circle cx="200" cy="200" r="64" fill="#111316" />
		<circle cx="200" cy="200" r="64" class="label-edge" />
		<image href={mark} x="168" y="170" width="64" height="57" />
		<circle cx="200" cy="200" r="4" fill="#0a0b0d" />
		<rect x="196" y="140" width="8" height="2" rx="1" fill="#f3f1eb" opacity="0.9" />
	</svg>
	<div class="sheen"></div>
</div>

<style>
	.record {
		position: relative;
		aspect-ratio: 1;
		width: min(100%, 420px);
		margin-inline: auto;
		border-radius: 50%;
		/* the turning square of the record stays inside its circle, never wider than the page */
		overflow: hidden;
		box-shadow:
			0 30px 80px rgb(0 0 0 / 0.6),
			0 0 0 1px var(--pr-line);
	}
	.disc {
		width: 100%;
		height: 100%;
		animation: turn 1.8s linear infinite;
	}
	.groove {
		fill: none;
		stroke: rgb(255 255 255 / 0.045);
		stroke-width: 1.2;
	}
	.gap {
		fill: none;
		stroke: rgb(255 255 255 / 0.1);
		stroke-width: 0.6;
	}
	.timecode {
		fill: none;
		stroke: rgb(243 241 235 / 0.16);
		stroke-width: 22;
		stroke-dasharray: 1.2 2.1;
	}
	.label-edge {
		fill: none;
		stroke: var(--pr-line-2);
	}
	/* the light stays where it is while the record turns under it */
	.sheen {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: conic-gradient(
			from 20deg,
			transparent 0deg,
			rgb(255 255 255 / 0.07) 25deg,
			transparent 55deg,
			transparent 180deg,
			rgb(143 123 255 / 0.08) 205deg,
			transparent 235deg
		);
		mix-blend-mode: screen;
		pointer-events: none;
	}
	@keyframes turn {
		to {
			transform: rotate(360deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.disc {
			animation: none;
		}
	}
</style>
