---
/**
 * Images opened in full with PhotoSwipe: a click (or Enter) on one marked `data-zoom`, or on
 * a screenshot of the documentation, opens it fitted to the screen, at its largest file. In
 * the viewer, pinch or the wheel zooms, a double tap goes closer and back, a drag moves the
 * picture or goes to the next one, and the page itself never zooms.
 */
interface Props {
	label: string;
	close: string;
}
const { label, close } = Astro.props;
---

<span hidden data-zoom-text data-label={label} data-close={close}></span>

<script>
	import PhotoSwipe from 'photoswipe';
	import 'photoswipe/style.css';

	const text = document.querySelector<HTMLElement>('[data-zoom-text]')?.dataset ?? {};
	const images = [...document.querySelectorAll<HTMLImageElement>('img[data-zoom], .sl-markdown-content img')];

	// the largest file the page has of an image, with its size, not the one sized for the layout
	const largest = (img: HTMLImageElement) => {
		const ratio = (img.naturalHeight || img.height) / (img.naturalWidth || img.width) || 1;
		const best = (img.getAttribute('srcset') ?? '')
			.split(',')
			.map((part) => part.trim().split(/\s+/))
			.filter(([url, size]) => url && size?.endsWith('w'))
			.map(([url, size]) => ({ src: url, width: parseInt(size) }))
			.sort((a, b) => b.width - a.width)[0];
		const src = best?.src ?? img.currentSrc ?? img.src;
		const width = best?.width ?? (img.naturalWidth || img.width);
		return { src, width, height: Math.round(width * ratio), alt: img.alt, element: img };
	};

	const open = (index: number) => {
		const viewer = new PhotoSwipe({
			dataSource: images.map(largest),
			index,
			bgOpacity: 0.97,
			closeTitle: text.close,
			zoomTitle: text.label,
			initialZoomLevel: 'fit',
			secondaryZoomLevel: (zoom) => Math.max(1, zoom.fit * 2.5),
			maxZoomLevel: (zoom) => Math.max(2, zoom.fit * 6),
			wheelToZoom: true,
			showHideAnimationType: 'fade',
			// a tap on the picture zooms it; on the dark around it, closes
			imageClickAction: 'zoom-or-close',
			tapAction: 'toggle-controls',
			bgClickAction: 'close',
		});
		viewer.init();
	};

	images.forEach((img, index) => {
		img.classList.add('zoomable');
		img.tabIndex = 0;
		img.setAttribute('role', 'button');
		img.setAttribute('aria-label', img.alt ? `${text.label}: ${img.alt}` : (text.label ?? ''));
		img.addEventListener('click', () => open(index));
		img.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				open(index);
			}
		});
	});
</script>

<style is:global>
	.zoomable {
		cursor: zoom-in;
	}
	.pswp {
		--pswp-bg: #0a0b0d;
		--pswp-icon-color: #e7e8ea;
		--pswp-icon-color-secondary: #0a0b0d;
		--pswp-icon-stroke-color: #0a0b0d;
	}
	.pswp__counter {
		font: 500 13px / 1 'Martian Mono', ui-monospace, monospace;
		font-stretch: 80%;
		color: #a1a6ae;
	}
</style>
