{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Prisme",
        "width": 1480,
        "height": 920,
        "minWidth": 1280,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 18 }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
