{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prisme",
  "identifier": "com.shawiizz.prisme",
  "build": {
    "frontendDist": "../../frontend/dist/frontend/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": { "script": "pnpm start", "cwd": "../../frontend" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../../frontend" }
  },
  "app": {
    "windows": [
      {
        "title": "Prisme",
        "width": 1480,
        "height": 920,
        "minWidth": 1280,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0a0b0d"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "publisher": "Shawiizz",
    "shortDescription": "DVS DJ software",
    "category": "Music",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 204, "y": 206 },
        "applicationFolderPosition": { "x": 456, "y": 206 }
      }
    }
  }
}
