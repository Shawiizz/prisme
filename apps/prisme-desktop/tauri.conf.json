{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prisme",
  "identifier": "com.shawiizz.prisme",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../../frontend/dist/frontend/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": { "script": "pnpm start", "cwd": "../../frontend" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../../frontend" }
  },
  "app": {
    "windows": [
      {
        "title": "Prisme",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
