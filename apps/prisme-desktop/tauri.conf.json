{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prisme",
  "identifier": "com.shawiizz.prisme",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../../frontend/dist/frontend/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": { "script": "pnpm start", "cwd": "../../frontend" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../../frontend" }
  },
  "app": {
    "windows": [
      {
        "title": "Prisme",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExNDg0MERDNzQ2RTRENDgKUldSSVRXNTAzRUJJb1JQR2QweVJ0WmhpeE9hN1BFRC9hRkJVQWJkZ0l3Y2dUdm41WmdyQXI1bzUK",
      "endpoints": ["https://github.com/Shawiizz/prisme/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Shawiizz",
    "shortDescription": "DVS DJ software",
    "category": "Music",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"],
        "displayLanguageSelector": false
      }
    }
  }
}
