{
  "$schema": "https://raw.githubusercontent.com/Shawiizz/prisme/main/apps/prisme-desktop/controllers/profile.schema.json",
  "name": "Hercules DJ Console Mac Edition",
  "ports": ["DJ Console Mac"],
  "credits": "From the Hercules DJ Console Mac Edition mapping of Mixxx by Daniel Svensson (GPL-2.0-or-later).",
  "jogStepsPerTurn": 64,
  "controls": [
    {"control": {"kind": "controlChange", "channel": 1, "number": 40}, "target": "mixer.crossfader"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 8}, "target": "deck1.play"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 9}, "target": "deck1.cue"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 10}, "target": "deck1.sync.once"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 21}, "target": "deck1.headphones"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 11}, "target": "library.previous", "also": ["library.load1"]},
    {"control": {"kind": "controlChange", "channel": 1, "number": 12}, "target": "library.next", "also": ["library.load1"]},
    {"control": {"kind": "controlChange", "channel": 1, "number": 19}, "target": "deck1.bend.up.small"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 20}, "target": "deck1.bend.down.small"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 45}, "target": "deck1.jog", "encoding": "relative"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 41}, "target": "deck1.pitch", "invert": true},
    {"control": {"kind": "controlChange", "channel": 1, "number": 43}, "target": "deck1.volume"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 39}, "target": "deck1.eq.high"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 38}, "target": "deck1.eq.mid"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 37}, "target": "deck1.eq.low"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 2}, "target": "deck2.play"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 3}, "target": "deck2.cue"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 4}, "target": "deck2.sync.once"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 25}, "target": "deck2.headphones"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 5}, "target": "library.previous", "also": ["library.load2"]},
    {"control": {"kind": "controlChange", "channel": 1, "number": 6}, "target": "library.next", "also": ["library.load2"]},
    {"control": {"kind": "controlChange", "channel": 1, "number": 23}, "target": "deck2.bend.up"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 24}, "target": "deck2.bend.down"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 46}, "target": "deck2.jog", "encoding": "relative"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 42}, "target": "deck2.pitch", "invert": true},
    {"control": {"kind": "controlChange", "channel": 1, "number": 44}, "target": "deck2.volume"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 36}, "target": "deck2.eq.high"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 35}, "target": "deck2.eq.mid"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 34}, "target": "deck2.eq.low"}
  ]
}
