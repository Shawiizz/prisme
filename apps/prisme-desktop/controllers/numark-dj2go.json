{
  "$schema": "https://raw.githubusercontent.com/Shawiizz/prisme/main/apps/prisme-desktop/controllers/profile.schema.json",
  "name": "Numark DJ2Go",
  "ports": ["Numark DJ2Go"],
  "credits": "From the Numark DJ2Go mapping of Mixxx by Alimantado, mod by Coval (GPL-2.0-or-later).",
  "jogStepsPerTurn": 60,
  "controls": [
    {"control": {"kind": "note", "channel": 0, "number": 59}, "target": "deck1.play", "light": {"on": 1, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 66}, "target": "deck2.play", "light": {"on": 1, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 51}, "target": "deck1.cue", "light": {"on": {"blink": [1, 0], "ms": 300}, "paused": {"blink": [1, 0], "ms": 300}, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 60}, "target": "deck2.cue", "light": {"on": {"blink": [1, 0], "ms": 300}, "paused": {"blink": [1, 0], "ms": 300}, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 64}, "target": "deck1.sync", "light": {"on": 1, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 71}, "target": "deck2.sync", "light": {"on": 1, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 101}, "target": "deck1.headphones", "light": {"on": 1, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 102}, "target": "deck2.headphones", "light": {"on": 1, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 101}, "target": "deck1.fx", "shift": true},
    {"control": {"kind": "note", "channel": 0, "number": 102}, "target": "deck2.fx", "shift": true},
    {"control": {"kind": "note", "channel": 0, "number": 68}, "target": "deck1.loop.in"},
    {"control": {"kind": "note", "channel": 0, "number": 70}, "target": "deck2.loop.in"},
    {"control": {"kind": "note", "channel": 0, "number": 67}, "target": "deck1.loop.out"},
    {"control": {"kind": "note", "channel": 0, "number": 69}, "target": "deck2.loop.out"},
    {"control": {"kind": "note", "channel": 0, "number": 75}, "target": "library.load1"},
    {"control": {"kind": "note", "channel": 0, "number": 52}, "target": "library.load2"},
    {"control": {"kind": "note", "channel": 0, "number": 90}, "target": "library.load"},
    {"control": {"kind": "note", "channel": 0, "number": 89}, "target": "shift"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 26}, "target": "library.browse", "encoding": "relative"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 25}, "target": "deck1.jog", "encoding": "relative"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 24}, "target": "deck2.jog", "encoding": "relative"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 13}, "target": "deck1.pitch"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 14}, "target": "deck2.pitch"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 8}, "target": "deck1.volume"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 9}, "target": "deck2.volume"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 10}, "target": "mixer.crossfader"}
  ]
}
