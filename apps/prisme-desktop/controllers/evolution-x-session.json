{
  "$schema": "https://raw.githubusercontent.com/Shawiizz/prisme/main/apps/prisme-desktop/controllers/profile.schema.json",
  "name": "Evolution X-Session",
  "ports": ["X-Session", "Xsession"],
  "credits": "From the Evolution X-Session mapping of Mixxx by Amias Channer (GPL-2.0-or-later).",
