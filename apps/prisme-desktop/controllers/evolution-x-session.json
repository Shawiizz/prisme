    {"control": {"kind": "note", "channel": 0, "number": 44}, "target": "deck1.headphones"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 24}, "target": "deck1.volume"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 25}, "target": "deck1.pitch", "invert": true},
    {"control": {"kind": "controlChange", "channel": 0, "number": 26}, "target": "deck1.trim"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 27}, "target": "deck1.eq.high"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 28}, "target": "deck1.eq.mid"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 29}, "target": "deck1.eq.low"},
    {"control": {"kind": "note", "channel": 0, "number": 69}, "target": "deck2.play"},
    {"control": {"kind": "note", "channel": 0, "number": 59}, "target": "deck2.cue"},
    {"control": {"kind": "note", "channel": 0, "number": 56}, "target": "deck2.search.back"},
    {"control": {"kind": "note", "channel": 0, "number": 57}, "target": "deck2.search.forward"},
    {"control": {"kind": "note", "channel": 0, "number": 45}, "target": "deck2.headphones"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 16}, "target": "deck2.volume"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 17}, "target": "deck2.pitch", "invert": true},
    {"control": {"kind": "controlChange", "channel": 0, "number": 18}, "target": "deck2.trim"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 19}, "target": "deck2.eq.high"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 20}, "target": "deck2.eq.mid"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 21}, "target": "deck2.eq.low"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 10}, "target": "mixer.crossfader"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 31}, "target": "mixer.balance"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 23}, "target": "mixer.main", "also": ["mixer.cueMix"]},
    {"control": {"kind": "controlChange", "channel": 0, "number": 22}, "target": "mixer.headphones"}
  ]
}
