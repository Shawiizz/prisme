        {
          "description": "Jumps or loops of so many beats (`deck1.jump.-8`, `deck1.loop.0.25`)",
          "pattern": "^deck[1-4]\\.(jump|loop)\\.[+-]?\\d+(\\.\\d+)?$"
        },
        {
          "description": "The key moved by so many semitones (`deck1.key.+2`)",
          "pattern": "^deck[1-4]\\.key\\.[+-]?\\d+$"
        },
        {
          "description": "A sample played as loud as the pad is hit",
          "pattern": "^deck[1-4]\\.sample[1-8]\\.velocity$"
        },
        {
          "description": "A mode of one of the profile's groups (`mode.<group>.<mode>`)",
          "pattern": "^mode\\.[^.]+\\.[^.]+$"
        }
      ],
      "description": "An action of Prisme",
      "type": "string"
    },
    "When": {
      "description": "A mode of a controller: `mode` of its group `group`.",
      "properties": {
        "group": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        }
      },
      "required": [
        "group",
        "mode"
      ],
      "type": "object"
    }
