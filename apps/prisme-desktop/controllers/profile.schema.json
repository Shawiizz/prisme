  "$id": "https://raw.githubusercontent.com/Shawiizz/prisme/main/apps/prisme-desktop/controllers/profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What Prisme knows of a controller model before anything is learnt on it: the controls\nit maps, the lights beyond those controls' own, and what it is sent once opened.",
  "properties": {
    "$schema": {
      "description": "The schema of the format, for editors: [`crate::SCHEMA_URL`].",
      "type": [
        "string",
        "null"
      ]
    },
    "close": {
      "description": "Sent when it is closed, after its lights went off.",
      "items": {
        "items": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "type": "array"
      },
      "type": "array"
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/ProfileControl"
      },
      "type": "array"
    },
    "credits": {
      "description": "Where the mapping comes from, when it is not Prisme's own.",
      "type": "string"
    },
    "init": {
      "description": "Sent when the controller is opened (a request for its knobs' positions, say).",
      "items": {
        "items": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "type": "array"
      },
      "type": "array"
    },
    "jogStepsPerTurn": {
      "description": "Steps in a turn of its jog wheels, measured on the controller.",
      "format": "double",
      "type": "number"
    },
    "keepAlive": {
      "anyOf": [
        {
          "$ref": "#/$defs/KeepAlive"
        },
        {
          "type": "null"
        }
      ],
      "description": "Sent again and again while it is open: some models stop answering without it."
    },
    "lights": {
      "items": {
        "$ref": "#/$defs/ProfileLight"
      },
      "type": "array"
    },
    "meters": {
      "items": {
        "$ref": "#/$defs/Meter"
      },
      "type": "array"
    },
    "modes": {
      "description": "Groups of its controls that drive other actions in each of their modes (the pad\npages of a side, chosen by its mode keys), when the controls send the same in each.",
      "items": {
        "$ref": "#/$defs/ModeGroup"
      },
      "type": "array"
    },
    "name": {
      "description": "The model, as the settings show it.",
      "type": "string"
    },
    "ports": {
      "description": "The controller is the MIDI port whose name holds one of these (case aside); of\nseveral models, the one whose name is the longest (a DDJ-SB2 is no DDJ-SB).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "verified": {
      "description": "Tried on the controller itself, not only read from another program's mapping.",
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "ports",
    "controls"
  ],
  "title": "Prisme controller profile",
  "type": "object"
}
