{
  "$defs": {
    "Control": {
      "description": "A physical control of a controller.",
      "properties": {
        "channel": {
          "description": "0 to 15.",
          "format": "uint8",
          "maximum": 15,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/ControlKind"
        },
        "number": {
          "description": "Note or controller number; 0 for the pitch bend.",
          "format": "uint8",
          "maximum": 127,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "channel",
        "number"
      ],
      "type": "object"
    },
    "ControlKind": {
      "oneOf": [
        {
          "enum": [
            "pitchBend"
          ],
          "type": "string"
        },
        {
          "const": "note",
          "description": "Buttons and pads.",
          "type": "string"
        },
        {
          "const": "controlChange",
          "description": "Knobs, faders, encoders (and the buttons of some controllers).",
          "type": "string"
        }
      ]
    },
    "Encoding": {
      "description": "How a control's values are read.",
      "oneOf": [
        {
          "const": "absolute",
          "description": "A position, from 0 to 1 (a button: 1 pressed, 0 released).",
          "type": "string"
        },
        {
          "const": "relative",
          "description": "An endless encoder sending steps in two's complement: 1 to 63 to the right, 127\n(one step) down to 65 to the left.",
          "type": "string"
        },
        {
          "const": "relativeOffset",
          "description": "Steps around 64: 65 is one step to the right, 63 one to the left (Pioneer, Numark).",
          "type": "string"
        },
        {
          "const": "relativeSigned",
          "description": "Steps with a sign bit: 1 to 63 to the right, 65 (one step) to 127 to the left.",
          "type": "string"
        }
      ]
    },
    "Hold": {
      "description": "A second action for a key held down for `ms` milliseconds: pressed and let go sooner, it\ndrives its own.",
      "properties": {
        "ms": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "ms",
        "target"
      ],
      "type": "object"
    },
    "KeepAlive": {
      "description": "A message sent every `every_ms` milliseconds.",
      "properties": {
        "everyMs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "everyMs",
        "message"
      ],
      "type": "object"
    },
    "LightValue": {
      "anyOf": [
        {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        {
          "description": "Each of the two values for `ms` milliseconds.",
          "properties": {
            "blink": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "ms": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "blink",
            "ms"
          ],
          "type": "object"
        }
      ],
      "description": "A light's value in a state: steady, or two in turn."
    },
    "LightValues": {
      "additionalProperties": {
        "$ref": "#/$defs/LightValue"
      },
      "description": "What a light shows for each state of its action: `on` and `off`, or the action's own\n(`loaded`, `playing`…). A state it does not name shows as `on`, but `off`: 127 and 0\nwhen it names neither.",
      "type": "object"
    },
    "Meter": {
      "description": "A level shown on the controller: `source`'s (`deck1`…, `main`), from 0 to `max` on\n`control`, along `curve` (the level raised to it: 1 straight).",
      "properties": {
        "control": {
          "$ref": "#/$defs/Control"
        },
        "curve": {
          "format": "float",
          "type": "number"
        },
        "max": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "enum": [
            "deck1",
            "deck2",
            "deck3",
            "deck4",
            "main"
          ],
          "type": "string"
        }
      },
      "required": [
        "source",
        "control"
      ],
      "type": "object"
    },
    "ModeGroup": {
      "description": "A group of controls and its modes, the first one to begin with, each chosen by a key\nwhose light shows whether it is the one (`on`, `off`).",
      "properties": {
        "group": {
          "type": "string"
        },
        "modes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "select": {
          "items": {
            "$ref": "#/$defs/ModeSelect"
          },
          "type": "array"
        }
      },
      "required": [
        "group",
        "modes",
        "select"
      ],
      "type": "object"
    },
    "ModeSelect": {
      "properties": {
        "control": {
          "$ref": "#/$defs/Control"
        },
        "light": {
          "$ref": "#/$defs/LightValues"
        },
        "mode": {
          "type": "string"
        },
        "shift": {
          "description": "Chosen while the controller's shift is held.",
          "type": "boolean"
        }
      },
      "required": [
        "control",
        "mode"
      ],
      "type": "object"
    },
    "ProfileControl": {
      "description": "A control of the model and the action it drives: a [`Mapping`] before a device has it.",
      "properties": {
        "also": {
          "description": "Other actions it drives along with its own.",
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        },
        "control": {
          "$ref": "#/$defs/Control"
        },
        "encoding": {
          "$ref": "#/$defs/Encoding"
        },
        "fine": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hold": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hold"
            },
            {
              "type": "null"
            }
          ],
          "description": "Another action for the key held down a while."
        },
        "invert": {
          "type": "boolean"
        },
        "light": {
          "$ref": "#/$defs/LightValues",
          "description": "Its light's values, when they are not 127 and 0."
        },
        "onValue": {
          "description": "Drives its action, as a key pressed, when the control sends this value.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "shift": {
          "type": "boolean"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/When"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "control",
        "target"
      ],
      "type": "object"
    },
    "ProfileLight": {
      "additionalProperties": {
        "$ref": "#/$defs/LightValue"
      },
      "description": "A light that is not the control of its action: its values by state beside it (`\"on\":\n100`, `\"playing\": {\"blink\": [9, 0], \"ms\": 250}`).",
      "properties": {
        "control": {
          "$ref": "#/$defs/Control"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/When"
            },
            {
              "type": "null"
            }
          ],
          "description": "While its group is in this mode only."
        }
      },
      "required": [
        "target",
        "control"
      ],
      "type": "object"
    },
