{
  "$schema": "https://raw.githubusercontent.com/Shawiizz/prisme/main/apps/prisme-desktop/controllers/profile.schema.json",
  "name": "Numark iDJ Live II",
  "ports": ["iDJ Live II"],
  "credits": "From the Numark iDJ Live II mapping of Mixxx by Nathan Korth (GPL-2.0-or-later).",
  "jogStepsPerTurn": 640,
  "init": [[240, 0, 1, 63, 127, 46, 96, 0, 1, 1, 247]],
  "close": [[144, 74, 0], [144, 64, 0], [144, 76, 0], [144, 71, 0], [144, 72, 0]],
  "controls": [
    {"control": {"kind": "note", "channel": 0, "number": 74}, "target": "deck1.play", "light": {"on": 127, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 76}, "target": "deck2.play", "light": {"on": 127, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 59}, "target": "deck1.cue.goto"},
    {"control": {"kind": "note", "channel": 0, "number": 51}, "target": "deck1.cue.set"},
    {"control": {"kind": "note", "channel": 0, "number": 66}, "target": "deck2.cue.goto"},
    {"control": {"kind": "note", "channel": 0, "number": 60}, "target": "deck2.cue.set"},
    {"control": {"kind": "note", "channel": 0, "number": 64}, "target": "deck1.sync", "light": {"on": 127, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 71}, "target": "deck2.sync", "light": {"on": 127, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 67}, "target": "deck1.bend.up"},
    {"control": {"kind": "note", "channel": 0, "number": 69}, "target": "deck2.bend.up"},
    {"control": {"kind": "note", "channel": 0, "number": 68}, "target": "deck1.bend.down"},
    {"control": {"kind": "note", "channel": 0, "number": 70}, "target": "deck2.bend.down"},
    {"control": {"kind": "note", "channel": 0, "number": 77}, "target": "deck1.jog.touch"},
    {"control": {"kind": "note", "channel": 0, "number": 78}, "target": "deck2.jog.touch"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 25}, "target": "deck1.jog", "encoding": "relative"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 24}, "target": "deck2.jog", "encoding": "relative"},
    {"control": {"kind": "note", "channel": 0, "number": 72}, "target": "deck1.jog.scratch", "also": ["deck2.jog.scratch"], "light": {"on": 127, "off": 0}},
    {"control": {"kind": "controlChange", "channel": 0, "number": 8}, "target": "deck1.volume"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 9}, "target": "deck2.volume"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 16}, "target": "deck1.eq.high"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 17}, "target": "deck2.eq.high"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 20}, "target": "deck1.eq.low"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 21}, "target": "deck2.eq.low"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 10}, "target": "mixer.crossfader", "invert": true},
    {"control": {"kind": "controlChange", "channel": 0, "number": 23}, "target": "mixer.main"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 26}, "target": "library.browse", "encoding": "relative"},
    {"control": {"kind": "note", "channel": 0, "number": 79}, "target": "general.library"},
    {"control": {"kind": "note", "channel": 0, "number": 75}, "target": "library.load1"},
    {"control": {"kind": "note", "channel": 0, "number": 52}, "target": "library.load2"}
  ]
}
