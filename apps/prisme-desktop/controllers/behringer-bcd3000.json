    {"control": {"kind": "controlChange", "channel": 0, "number": 7}, "target": "deck2.eq.low"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 8}, "target": "deck2.eq.mid"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 9}, "target": "deck2.eq.high"},
