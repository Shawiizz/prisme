  "lights": [
    {"target": "deck1.loop.any", "control": {"kind": "controlChange", "channel": 0, "number": 21}, "on": 127, "off": 0},
    {"target": "deck2.loop.any", "control": {"kind": "controlChange", "channel": 0, "number": 13}, "on": 127, "off": 0},
    {"target": "mode.browse.deck1", "control": {"kind": "controlChange", "channel": 0, "number": 6}, "on": 127, "off": 0},
    {"target": "mode.browse.deck2", "control": {"kind": "controlChange", "channel": 0, "number": 3}, "on": 127, "off": 0},
    {"target": "mode.keylock.on", "control": {"kind": "controlChange", "channel": 0, "number": 25}, "on": 127, "off": 0}
