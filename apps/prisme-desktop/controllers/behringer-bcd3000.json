    {"control": {"kind": "note", "channel": 0, "number": 31}, "target": "mode.browse.deck1", "when": {"group": "browse", "mode": "deck2"}},
    {"control": {"kind": "note", "channel": 0, "number": 34}, "target": "mode.browse.deck2", "when": {"group": "browse", "mode": "off"}},
    {"control": {"kind": "note", "channel": 0, "number": 34}, "target": "mode.browse.off", "when": {"group": "browse", "mode": "deck2"}, "also": ["library.load2"]},
    {"control": {"kind": "note", "channel": 0, "number": 34}, "target": "mode.browse.deck2", "when": {"group": "browse", "mode": "deck1"}},
    {"control": {"kind": "controlChange", "channel": 0, "number": 19}, "target": "deck1.jog", "encoding": "relativeOffset", "when": {"group": "browse", "mode": "off"}},
    {"control": {"kind": "controlChange", "channel": 0, "number": 18}, "target": "deck2.jog", "encoding": "relativeOffset", "when": {"group": "browse", "mode": "off"}},
    {"control": {"kind": "controlChange", "channel": 0, "number": 19}, "target": "library.browse", "encoding": "relativeOffset", "when": {"group": "browse", "mode": "deck1"}},
    {"control": {"kind": "controlChange", "channel": 0, "number": 18}, "target": "library.browse", "encoding": "relativeOffset", "when": {"group": "browse", "mode": "deck1"}},
    {"control": {"kind": "controlChange", "channel": 0, "number": 19}, "target": "library.browse", "encoding": "relativeOffset", "when": {"group": "browse", "mode": "deck2"}},
    {"control": {"kind": "controlChange", "channel": 0, "number": 18}, "target": "library.browse", "encoding": "relativeOffset", "when": {"group": "browse", "mode": "deck2"}},
