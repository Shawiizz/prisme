{
  "$schema": "https://raw.githubusercontent.com/Shawiizz/prisme/main/apps/prisme-desktop/controllers/profile.schema.json",
  "name": "Vestax VCI-100 (Hile Mod)",
  "ports": ["VCI-100"],
  "credits": "From the Vestax VCI-100 Hile Mod mapping of Mixxx by Ilkka Tuohela (GPL-2.0-or-later).",
  "variant": true,
  "jogStepsPerTurn": 256,
  "init": [[144, 12, 0], [144, 13, 0], [144, 68, 0], [144, 69, 0], [144, 76, 0], [144, 85, 0], [144, 88, 0], [144, 91, 0], [144, 107, 0], [144, 108, 0]],
  "modes": [
    {"group": "looper", "modes": ["deck1", "deck2"], "select": [
      {"control": {"kind": "note", "channel": 0, "number": 66}, "mode": "deck1"},
      {"control": {"kind": "note", "channel": 0, "number": 67}, "mode": "deck2"}
    ]}
  ],
  "controls": [
    {"control": {"kind": "controlChange", "channel": 0, "number": 8}, "target": "mixer.crossfader"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 28}, "target": "mixer.headphones"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 29}, "target": "mixer.cueMix"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 12}, "target": "deck1.volume"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 13}, "target": "deck2.volume"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 14}, "target": "deck1.pitch"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 15}, "target": "deck2.pitch"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 20}, "target": "deck1.trim"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 21}, "target": "deck1.eq.high"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 22}, "target": "deck1.eq.mid"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 23}, "target": "deck1.eq.low"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 24}, "target": "deck2.trim"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 25}, "target": "deck2.eq.high"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 26}, "target": "deck2.eq.mid"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 27}, "target": "deck2.eq.low"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 16}, "target": "deck1.jog", "encoding": "relativeOffset"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 18}, "target": "deck1.jog", "encoding": "relativeOffset"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 17}, "target": "deck2.jog", "encoding": "relativeOffset"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 19}, "target": "deck2.jog", "encoding": "relativeOffset"},
    {"control": {"kind": "note", "channel": 0, "number": 46}, "target": "deck1.jog.touch"},
    {"control": {"kind": "note", "channel": 0, "number": 47}, "target": "deck2.jog.touch"},
    {"control": {"kind": "note", "channel": 0, "number": 50}, "target": "deck1.play"},
    {"control": {"kind": "note", "channel": 0, "number": 54}, "target": "deck2.play"},
    {"control": {"kind": "note", "channel": 0, "number": 51}, "target": "deck1.cue.play", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 55}, "target": "deck2.cue.play", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 52}, "target": "deck1.cue", "light": {"on": 0, "paused": 0, "off": 0, "pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 56}, "target": "deck2.cue", "light": {"on": 0, "paused": 0, "off": 0, "pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 53}, "target": "deck1.cue.set", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 57}, "target": "deck2.cue.set", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 58}, "target": "deck1.bend.up", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 59}, "target": "deck1.bend.down", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 60}, "target": "deck2.bend.up", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 61}, "target": "deck2.bend.down", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 70}, "target": "deck1.sync.once", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 71}, "target": "deck2.sync.once", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 72}, "target": "deck1.headphones"},
    {"control": {"kind": "note", "channel": 0, "number": 73}, "target": "deck2.headphones"},
    {"control": {"kind": "note", "channel": 0, "number": 74}, "target": "general.quantize"},
    {"control": {"kind": "note", "channel": 0, "number": 75}, "target": "general.quantize"},
    {"control": {"kind": "note", "channel": 0, "number": 98}, "target": "deck1.loop.in", "when": {"group": "looper", "mode": "deck1"}, "light": {"on": 0, "off": 0, "pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 99}, "target": "deck1.loop.out", "when": {"group": "looper", "mode": "deck1"}, "light": {"on": 0, "off": 0, "pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 100}, "target": "deck1.reloop", "when": {"group": "looper", "mode": "deck1"}, "light": {"on": 0, "off": 0, "pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 101}, "target": "deck1.loop.1", "when": {"group": "looper", "mode": "deck1"}},
    {"control": {"kind": "note", "channel": 0, "number": 102}, "target": "deck1.loop.2", "when": {"group": "looper", "mode": "deck1"}},
    {"control": {"kind": "note", "channel": 0, "number": 103}, "target": "deck1.loop.4", "when": {"group": "looper", "mode": "deck1"}},
    {"control": {"kind": "note", "channel": 0, "number": 104}, "target": "deck1.loop.8", "when": {"group": "looper", "mode": "deck1"}},
    {"control": {"kind": "note", "channel": 0, "number": 98}, "target": "deck2.loop.in", "when": {"group": "looper", "mode": "deck2"}, "light": {"on": 0, "off": 0, "pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 99}, "target": "deck2.loop.out", "when": {"group": "looper", "mode": "deck2"}, "light": {"on": 0, "off": 0, "pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 100}, "target": "deck2.reloop", "when": {"group": "looper", "mode": "deck2"}, "light": {"on": 0, "off": 0, "pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 101}, "target": "deck2.loop.1", "when": {"group": "looper", "mode": "deck2"}},
    {"control": {"kind": "note", "channel": 0, "number": 102}, "target": "deck2.loop.2", "when": {"group": "looper", "mode": "deck2"}},
    {"control": {"kind": "note", "channel": 0, "number": 103}, "target": "deck2.loop.4", "when": {"group": "looper", "mode": "deck2"}},
    {"control": {"kind": "note", "channel": 0, "number": 104}, "target": "deck2.loop.8", "when": {"group": "looper", "mode": "deck2"}},
    {"control": {"kind": "note", "channel": 0, "number": 92}, "target": "library.previous", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 93}, "target": "library.next", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 94}, "target": "library.go", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 96}, "target": "library.load1", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 97}, "target": "library.load2", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 79}, "target": "library.list.previous", "light": {"pressed": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 82}, "target": "library.list.next", "light": {"pressed": 127}}
  ]
}
