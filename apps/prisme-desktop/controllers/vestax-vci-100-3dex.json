{
  "$schema": "https://raw.githubusercontent.com/Shawiizz/prisme/main/apps/prisme-desktop/controllers/profile.schema.json",
  "name": "Vestax VCI-100 (MixVibes 3DEX Edition)",
  "ports": ["VCI-100"],
  "credits": "From the Vestax VCI-100 (MixVibes 3DEX Edition) mapping of Mixxx by Julius Alexander Kohout edler von Dolnobransky (GPL-2.0-or-later).",
  "variant": true,
  "jogStepsPerTurn": 384,
  "init": [[144, 103, 127], [128, 104, 127], [128, 50, 127], [128, 54, 127], [128, 72, 127], [128, 73, 127], [128, 74, 127], [128, 75, 127], [128, 66, 127], [128, 67, 127], [128, 68, 127], [128, 69, 127], [128, 98, 127], [128, 99, 127], [128, 100, 127], [128, 70, 127], [128, 71, 127]],
  "modes": [
    {"group": "loopDeck", "modes": ["deck1", "deck2"], "select": [
      {"control": {"kind": "note", "channel": 0, "number": 103}, "mode": "deck1"},
      {"control": {"kind": "note", "channel": 0, "number": 104}, "mode": "deck2"}
    ]},
    {"group": "cue1", "modes": ["c1", "c2", "c3", "c4"], "select": []},
    {"group": "cue2", "modes": ["c1", "c2", "c3", "c4"], "select": []}
  ],
  "controls": [
    {"control": {"kind": "controlChange", "channel": 0, "number": 8}, "target": "mixer.crossfader"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 7}, "target": "mixer.main"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 88}, "target": "mixer.headphones"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 89}, "target": "mixer.cueMix"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 70}, "target": "mixer.mic"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 84}, "target": "mixer.mic"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 72}, "target": "deck1.fx.param2", "also": ["deck2.fx.param2"]},
    {"control": {"kind": "controlChange", "channel": 0, "number": 73}, "target": "deck1.fx.period", "also": ["deck2.fx.period"]},
    {"control": {"kind": "controlChange", "channel": 0, "number": 86}, "target": "deck1.fx.param2", "also": ["deck2.fx.param2"]},
    {"control": {"kind": "controlChange", "channel": 0, "number": 87}, "target": "deck1.fx.period", "also": ["deck2.fx.period"]},

    {"control": {"kind": "note", "channel": 0, "number": 92}, "target": "library.previous"},
    {"control": {"kind": "note", "channel": 0, "number": 93}, "target": "library.next"},
    {"control": {"kind": "note", "channel": 0, "number": 94}, "target": "library.load"},
    {"control": {"kind": "note", "channel": 0, "number": 96}, "target": "library.load1"},
    {"control": {"kind": "note", "channel": 0, "number": 97}, "target": "library.load2"},

    {"control": {"kind": "note", "channel": 0, "number": 98}, "target": "deck1.loop.in", "when": {"group": "loopDeck", "mode": "deck1"}},
    {"control": {"kind": "note", "channel": 0, "number": 99}, "target": "deck1.loop.out", "when": {"group": "loopDeck", "mode": "deck1"}},
    {"control": {"kind": "note", "channel": 0, "number": 100}, "target": "deck1.reloop", "when": {"group": "loopDeck", "mode": "deck1"}},
    {"control": {"kind": "note", "channel": 0, "number": 101}, "target": "deck1.loop.halve", "when": {"group": "loopDeck", "mode": "deck1"}},
    {"control": {"kind": "note", "channel": 0, "number": 102}, "target": "deck1.loop.double", "when": {"group": "loopDeck", "mode": "deck1"}},
    {"control": {"kind": "note", "channel": 0, "number": 98}, "target": "deck2.loop.in", "when": {"group": "loopDeck", "mode": "deck2"}},
    {"control": {"kind": "note", "channel": 0, "number": 99}, "target": "deck2.loop.out", "when": {"group": "loopDeck", "mode": "deck2"}},
    {"control": {"kind": "note", "channel": 0, "number": 100}, "target": "deck2.reloop", "when": {"group": "loopDeck", "mode": "deck2"}},
    {"control": {"kind": "note", "channel": 0, "number": 101}, "target": "deck2.loop.halve", "when": {"group": "loopDeck", "mode": "deck2"}},
    {"control": {"kind": "note", "channel": 0, "number": 102}, "target": "deck2.loop.double", "when": {"group": "loopDeck", "mode": "deck2"}},

    {"control": {"kind": "note", "channel": 0, "number": 84}, "target": "deck1.sample1.smart", "light": {"off": 0, "loaded": 0, "playing": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 87}, "target": "deck1.sample2.smart", "light": {"off": 0, "loaded": 0, "playing": 127}},
    {"control": {"kind": "note", "channel": 0, "number": 90}, "target": "deck1.sample3.smart", "light": {"off": 0, "loaded": 0, "playing": 127}},

    {"control": {"kind": "controlChange", "channel": 0, "number": 12}, "target": "deck1.volume"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 20}, "target": "deck1.trim"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 21}, "target": "deck1.eq.high"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 22}, "target": "deck1.eq.mid"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 23}, "target": "deck1.eq.low"},
    {"control": {"kind": "note", "channel": 0, "number": 14}, "target": "deck1.trim", "set": 0.5},
    {"control": {"kind": "note", "channel": 0, "number": 15}, "target": "deck1.eq.high", "set": 0.5},
    {"control": {"kind": "note", "channel": 0, "number": 16}, "target": "deck1.eq.mid", "set": 0.5},
    {"control": {"kind": "note", "channel": 0, "number": 17}, "target": "deck1.eq.low", "set": 0.5},
    {"control": {"kind": "controlChange", "channel": 0, "number": 14}, "target": "deck1.pitch"},
    {"control": {"kind": "note", "channel": 0, "number": 48}, "target": "deck1.jog.touch"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 16}, "target": "deck1.jog", "encoding": "relativeOffset"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 18}, "target": "deck1.jog", "encoding": "relativeOffset"},
    {"control": {"kind": "note", "channel": 0, "number": 50}, "target": "deck1.play"},
    {"control": {"kind": "note", "channel": 0, "number": 51}, "target": "mode.cue1.c2", "also": ["deck1.hotcue1"], "when": {"group": "cue1", "mode": "c1"}, "light": {"on": 0, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 51}, "target": "mode.cue1.c3", "also": ["deck1.hotcue2"], "when": {"group": "cue1", "mode": "c2"}, "light": {"on": 0, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 51}, "target": "mode.cue1.c4", "also": ["deck1.hotcue3"], "when": {"group": "cue1", "mode": "c3"}, "light": {"on": 0, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 51}, "target": "mode.cue1.c1", "also": ["deck1.hotcue4"], "when": {"group": "cue1", "mode": "c4"}, "light": {"on": 0, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 52}, "target": "deck1.start"},
    {"control": {"kind": "note", "channel": 0, "number": 53}, "target": "deck1.loop"},
    {"control": {"kind": "note", "channel": 0, "number": 72}, "target": "deck1.headphones"},
    {"control": {"kind": "note", "channel": 0, "number": 68}, "target": "deck1.reverse"},
    {"control": {"kind": "note", "channel": 0, "number": 66}, "target": "deck1.keylock"},
    {"control": {"kind": "note", "channel": 0, "number": 70}, "target": "deck1.sync.once"},
    {"control": {"kind": "note", "channel": 0, "number": 74}, "target": "deck1.fx.flanger"},
    {"control": {"kind": "note", "channel": 0, "number": 58}, "target": "deck1.bend.up"},
    {"control": {"kind": "note", "channel": 0, "number": 59}, "target": "deck1.bend.down"},

    {"control": {"kind": "controlChange", "channel": 0, "number": 13}, "target": "deck2.volume"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 24}, "target": "deck2.trim"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 25}, "target": "deck2.eq.high"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 26}, "target": "deck2.eq.mid"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 27}, "target": "deck2.eq.low"},
    {"control": {"kind": "note", "channel": 0, "number": 18}, "target": "deck2.trim", "set": 0.5},
    {"control": {"kind": "note", "channel": 0, "number": 19}, "target": "deck2.eq.high", "set": 0.5},
    {"control": {"kind": "note", "channel": 0, "number": 20}, "target": "deck2.eq.mid", "set": 0.5},
    {"control": {"kind": "note", "channel": 0, "number": 21}, "target": "deck2.eq.low", "set": 0.5},
    {"control": {"kind": "controlChange", "channel": 0, "number": 15}, "target": "deck2.pitch"},
    {"control": {"kind": "note", "channel": 0, "number": 49}, "target": "deck2.jog.touch"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 17}, "target": "deck2.jog", "encoding": "relativeOffset"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 19}, "target": "deck2.jog", "encoding": "relativeOffset"},
    {"control": {"kind": "note", "channel": 0, "number": 54}, "target": "deck2.play"},
    {"control": {"kind": "note", "channel": 0, "number": 55}, "target": "mode.cue2.c2", "also": ["deck2.hotcue1"], "when": {"group": "cue2", "mode": "c1"}, "light": {"on": 0, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 55}, "target": "mode.cue2.c3", "also": ["deck2.hotcue2"], "when": {"group": "cue2", "mode": "c2"}, "light": {"on": 0, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 55}, "target": "mode.cue2.c4", "also": ["deck2.hotcue3"], "when": {"group": "cue2", "mode": "c3"}, "light": {"on": 0, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 55}, "target": "mode.cue2.c1", "also": ["deck2.hotcue4"], "when": {"group": "cue2", "mode": "c4"}, "light": {"on": 0, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 56}, "target": "deck2.start"},
    {"control": {"kind": "note", "channel": 0, "number": 57}, "target": "deck2.loop"},
    {"control": {"kind": "note", "channel": 0, "number": 73}, "target": "deck2.headphones"},
    {"control": {"kind": "note", "channel": 0, "number": 69}, "target": "deck2.reverse"},
    {"control": {"kind": "note", "channel": 0, "number": 67}, "target": "deck2.keylock"},
    {"control": {"kind": "note", "channel": 0, "number": 71}, "target": "deck2.sync.once"},
    {"control": {"kind": "note", "channel": 0, "number": 75}, "target": "deck2.fx.flanger"},
    {"control": {"kind": "note", "channel": 0, "number": 60}, "target": "deck2.bend.up"},
    {"control": {"kind": "note", "channel": 0, "number": 61}, "target": "deck2.bend.down"}
  ],
  "lights": [
    {"target": "deck1.beat", "control": {"kind": "note", "channel": 0, "number": 70}},
    {"target": "deck2.beat", "control": {"kind": "note", "channel": 0, "number": 71}},
    {"target": "deck1.reloop.stop", "control": {"kind": "note", "channel": 0, "number": 99}, "when": {"group": "loopDeck", "mode": "deck1"}},
    {"target": "deck2.reloop.stop", "control": {"kind": "note", "channel": 0, "number": 99}, "when": {"group": "loopDeck", "mode": "deck2"}},
    {"target": "deck1.loop.any", "control": {"kind": "note", "channel": 0, "number": 100}, "when": {"group": "loopDeck", "mode": "deck1"}},
    {"target": "deck2.loop.any", "control": {"kind": "note", "channel": 0, "number": 100}, "when": {"group": "loopDeck", "mode": "deck2"}}
  ]
}
