{
  "$schema": "https://raw.githubusercontent.com/Shawiizz/prisme/main/apps/prisme-desktop/controllers/profile.schema.json",
  "name": "Intech Studio TEK2",
  "ports": ["TEK2"],
  "credits": "From the Intech TEK2 mapping of Mixxx (GPL-2.0-or-later).",
  "jogStepsPerTurn": 100,
  "controls": [
    {"control": {"kind": "note", "channel": 0, "number": 32}, "target": "deck1.play"},
    {"control": {"kind": "note", "channel": 0, "number": 33}, "target": "deck1.cue"},
    {"control": {"kind": "note", "channel": 0, "number": 40}, "target": "deck1.jog.touch"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 8}, "target": "deck1.jog", "encoding": "relativeOffset"},
    {"control": {"kind": "note", "channel": 0, "number": 34}, "target": "deck2.play"},
    {"control": {"kind": "note", "channel": 0, "number": 35}, "target": "deck2.cue"},
    {"control": {"kind": "note", "channel": 0, "number": 41}, "target": "deck2.jog.touch"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 9}, "target": "deck2.jog", "encoding": "relativeOffset"}
  ]
}
