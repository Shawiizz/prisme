    {"control": {"kind": "note", "channel": 0, "number": 53}, "target": "deck2.eq.low.kill", "latch": true},
    {"control": {"kind": "note", "channel": 0, "number": 34}, "target": "deck2.eq.mid.kill", "latch": true},
    {"control": {"kind": "note", "channel": 0, "number": 68}, "target": "deck2.eq.high.kill", "latch": true},
    {"control": {"kind": "note", "channel": 0, "number": 17}, "target": "deck1.headphones"},
