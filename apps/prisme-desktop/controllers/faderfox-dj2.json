    {"control": {"kind": "note", "channel": 0, "number": 71}, "target": "deck2.jump.-1"},
    {"control": {"kind": "note", "channel": 0, "number": 70}, "target": "deck2.jump.1"},
    {"control": {"kind": "note", "channel": 0, "number": 24}, "target": "deck1.grid.here"},
    {"control": {"kind": "note", "channel": 0, "number": 54}, "target": "deck2.grid.here"},
    {"control": {"kind": "note", "channel": 0, "number": 39}, "target": "general.quantize"},
    {"control": {"kind": "note", "channel": 0, "number": 69}, "target": "general.quantize"},
    {"control": {"kind": "note", "channel": 0, "number": 20}, "target": "deck1.fx.chain"},
    {"control": {"kind": "note", "channel": 0, "number": 50}, "target": "deck2.fx.chain"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 4}, "target": "deck1.fx.mix", "also": ["deck1.fx2.mix", "deck1.fx3.mix"]},
    {"control": {"kind": "controlChange", "channel": 0, "number": 6}, "target": "deck1.fx.super"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 20}, "target": "deck2.fx.mix", "also": ["deck2.fx2.mix", "deck2.fx3.mix"]},
    {"control": {"kind": "controlChange", "channel": 0, "number": 22}, "target": "deck2.fx.super"},
    {"control": {"kind": "note", "channel": 0, "number": 15}, "target": "library.load1"},
    {"control": {"kind": "note", "channel": 0, "number": 16}, "target": "library.load2"},
    {"control": {"kind": "note", "channel": 0, "number": 11}, "target": "library.next"},
    {"control": {"kind": "note", "channel": 0, "number": 12}, "target": "library.previous"}
