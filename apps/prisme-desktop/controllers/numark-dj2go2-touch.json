    {"control": {"kind": "note", "channel": 5, "number": 17}, "target": "deck2.loop.1"},
    {"control": {"kind": "note", "channel": 5, "number": 18}, "target": "deck2.loop.2"},
    {"control": {"kind": "note", "channel": 5, "number": 19}, "target": "deck2.loop.4"},
    {"control": {"kind": "note", "channel": 5, "number": 20}, "target": "deck2.loop.8"},
    {"control": {"kind": "note", "channel": 4, "number": 33}, "target": "deck1.loop.in"},
    {"control": {"kind": "note", "channel": 5, "number": 33}, "target": "deck2.loop.in"},
