    {"control": {"kind": "note", "channel": 1, "number": 0}, "target": "deck2.play"},
    {"control": {"kind": "note", "channel": 0, "number": 1}, "target": "deck1.cue", "light": {"on": 127, "paused": {"blink": [127, 0], "ms": 500}, "off": 0}},
    {"control": {"kind": "note", "channel": 1, "number": 1}, "target": "deck2.cue", "light": {"on": 127, "paused": {"blink": [127, 0], "ms": 500}, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 2}, "target": "deck1.sync"},
    {"control": {"kind": "note", "channel": 1, "number": 2}, "target": "deck2.sync"},
    {"control": {"kind": "note", "channel": 0, "number": 27}, "target": "deck1.headphones"},
    {"control": {"kind": "note", "channel": 1, "number": 27}, "target": "deck2.headphones"},
    {"control": {"kind": "note", "channel": 15, "number": 2}, "target": "library.load1"},
    {"control": {"kind": "note", "channel": 15, "number": 3}, "target": "library.load2"},
    {"control": {"kind": "note", "channel": 0, "number": 6}, "target": "deck1.jog.touch"},
