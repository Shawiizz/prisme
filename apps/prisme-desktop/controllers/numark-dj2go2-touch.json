{
  "$schema": "https://raw.githubusercontent.com/Shawiizz/prisme/main/apps/prisme-desktop/controllers/profile.schema.json",
  "name": "Numark DJ2GO2 Touch",
  "ports": ["DJ2GO2 Touch", "Numark DJ2GO2"],
  "credits": "From the Numark DJ2GO2 Touch mapping of Mixxx by tandy1000 (GPL-2.0-or-later).",
  "jogStepsPerTurn": 236,
  "init": [[240, 0, 1, 63, 60, 72, 247]],
  "controls": [
