    {"control": {"kind": "controlChange", "channel": 0, "number": 22}, "target": "deck1.filter"},
    {"control": {"kind": "controlChange", "channel": 1, "number": 22}, "target": "deck2.filter"},
    {"control": {"kind": "note", "channel": 4, "number": 1}, "target": "deck1.hotcue1"},
    {"control": {"kind": "note", "channel": 4, "number": 2}, "target": "deck1.hotcue2"},
    {"control": {"kind": "note", "channel": 4, "number": 3}, "target": "deck1.hotcue3"},
    {"control": {"kind": "note", "channel": 4, "number": 4}, "target": "deck1.hotcue4"},
    {"control": {"kind": "note", "channel": 5, "number": 1}, "target": "deck2.hotcue1"},
