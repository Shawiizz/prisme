{
  "$schema": "https://raw.githubusercontent.com/Shawiizz/prisme/main/apps/prisme-desktop/controllers/profile.schema.json",
  "name": "Ion Discover DJ",
  "ports": ["Discover DJ"],
  "credits": "From the Ion Discover DJ mapping of Mixxx by Rick Prokup (GPL-2.0-or-later).",
  "jogStepsPerTurn": 384,
  "controls": [
    {"control": {"kind": "note", "channel": 0, "number": 74}, "target": "deck1.play"},
    {"control": {"kind": "note", "channel": 0, "number": 76}, "target": "deck2.play"},
    {"control": {"kind": "note", "channel": 0, "number": 59}, "target": "deck1.cue", "light": {"on": 127, "paused": {"blink": [127, 0], "ms": 500}, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 66}, "target": "deck2.cue", "light": {"on": 127, "paused": {"blink": [127, 0], "ms": 500}, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 64}, "target": "deck1.sync", "light": {"on": 0, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 71}, "target": "deck2.sync", "light": {"on": 0, "off": 0}},
    {"control": {"kind": "note", "channel": 0, "number": 51}, "target": "deck1.reverse.held"},
    {"control": {"kind": "note", "channel": 0, "number": 60}, "target": "deck2.reverse.held"},
    {"control": {"kind": "note", "channel": 0, "number": 67}, "target": "deck1.tempo.down"},
    {"control": {"kind": "note", "channel": 0, "number": 68}, "target": "deck1.tempo.up"},
    {"control": {"kind": "note", "channel": 0, "number": 69}, "target": "deck2.tempo.down"},
    {"control": {"kind": "note", "channel": 0, "number": 70}, "target": "deck2.tempo.up"},
    {"control": {"kind": "note", "channel": 0, "number": 72}, "target": "deck1.jog.scratch.on", "onValue": 127, "also": ["deck2.jog.scratch.on"]},
    {"control": {"kind": "note", "channel": 0, "number": 72}, "target": "deck1.jog.scratch.off", "onValue": 0, "also": ["deck2.jog.scratch.off"], "light": {"on": 0, "off": 127}},
    {"control": {"kind": "controlChange", "channel": 0, "number": 25}, "target": "deck1.jog", "encoding": "relative"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 24}, "target": "deck2.jog", "encoding": "relative"},
    {"control": {"kind": "note", "channel": 0, "number": 77}, "target": "deck1.jog.touch"},
    {"control": {"kind": "note", "channel": 0, "number": 78}, "target": "deck2.jog.touch"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 16}, "target": "deck1.eq.high"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 20}, "target": "deck1.eq.mid"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 8}, "target": "deck1.eq.low"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 17}, "target": "deck2.eq.high"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 21}, "target": "deck2.eq.mid"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 9}, "target": "deck2.eq.low"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 10}, "target": "mixer.crossfader", "invert": true},
    {"control": {"kind": "controlChange", "channel": 0, "number": 23}, "target": "mixer.main"},
    {"control": {"kind": "controlChange", "channel": 0, "number": 26}, "target": "library.browse", "encoding": "relative"},
    {"control": {"kind": "note", "channel": 0, "number": 75}, "target": "library.load1"},
    {"control": {"kind": "note", "channel": 0, "number": 52}, "target": "library.load2"},
    {"control": {"kind": "note", "channel": 0, "number": 79}, "target": "general.library", "light": {"on": 0, "off": 0}}
  ],
  "lights": [
    {"target": "deck1.beat", "control": {"kind": "note", "channel": 0, "number": 64}},
    {"target": "deck2.beat", "control": {"kind": "note", "channel": 0, "number": 71}}
  ]
}
